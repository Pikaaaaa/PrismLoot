# --- Local (SQLite). Copy to .env for npm run dev ---
DATABASE_URL="file:./dev.db"

# --- Production (Vercel + Neon). SQLite files do not persist on Vercel. ---
# Use Neon's pooled URI (host contains -pooler). sslmode=require is required.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Optional unpooled URI for Prisma db push. Falls back to DATABASE_URL with `-pooler` stripped.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# long random string — never commit the real value
ADMIN_SECRET=

# Unguessable URL slug for the operator console (do not use /admin)
ADMIN_PATH="/pl-console-9f3k"

# Public origin when hosted (no trailing slash). Required for Steam OpenID realm/return_to.
# On Vercel this must be the exact https://….vercel.app URL (or custom domain) and you must Redeploy after saving it.
NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Optional. Fetches Steam persona name + avatar on first login (GetPlayerSummaries).
# Without it, the account still works with steamid64 and a fallback display name.
STEAM_API_KEY=

# Optional session HMAC. Falls back to ADMIN_SECRET if unset.
SESSION_SECRET=

# Cashier addresses (overlay the built-in placeholders)
DEPOSIT_ADDR_USDT_TRC20="TPRISMDEMOUSDTTRC20XXXXXXXXXXXXXXX"
DEPOSIT_ADDR_USDT_ERC20="0xDE00PRISMLOOTUSDTDEMO0000000000000001"
DEPOSIT_ADDR_BTC="bc1qprismlootdemodemo0000000000000000"
DEPOSIT_ADDR_TRX="TPRISMDEMOTRXADDRESSXXXXXXXXXXXXXXX"
DEPOSIT_ADDR_LTC="ltc1qprismlootdemodemo00000000000000"
DEPOSIT_ADDR_ETH="0xDE00PRISMLOOTETHDEMO0000000000000002"
DEPOSIT_ADDR_USDC_ERC20="0xDE00PRISMLOOTUSDCDEMO000000000000003"
DEPOSIT_ADDR_USDC_TRC20="TPRISMDEMOUSDCTRC20XXXXXXXXXXXXXXX"
